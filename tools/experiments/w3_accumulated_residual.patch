+    /**
+     * W3: accumulated residual along each block's motion track: A_t(i) = r_t(i) + d * A_{t-1}(j),
+     * where j is the block that i came from (its centre moved by its own vector). A steady mover's
+     * residual builds up towards r / (1 - d); random noise grows only by 1 / sqrt(1 - d^2).
+     */
+    static float[][] accumulate(float[][] r, float[][] prev, MotionField mv, double d) {
+        int n = r[0].length;
+        float[] ax = new float[n];
+        float[] ay = new float[n];
+        int cols = mv.cols();
+        int rows = mv.rows();
+        for (int i = 0; i < n; i++) {
+            ax[i] = r[0][i];
+            ay[i] = r[1][i];
+            if (prev != null) {
+                int cx = i % cols;
+                int cy = i / cols;
+                int x = Math.floorDiv(cx * Types.MB + Types.MB / 2 + mv.dx()[i], Types.MB);
+                int y = Math.floorDiv(cy * Types.MB + Types.MB / 2 + mv.dy()[i], Types.MB);
+                int j = Math.min(rows - 1, Math.max(0, y)) * cols + Math.min(cols - 1, Math.max(0, x));
+                ax[i] += (float) (d * prev[0][j]);
+                ay[i] += (float) (d * prev[1][j]);
+            }
+        }
+        return new float[][] {ax, ay};
+    }
+
+    /**
+     * W3 slow-mover pass: blocks the main pass did not consider (residual at most resPx) whose
+     * accumulated residual exceeds accPx, that are eligible and that the camera's exact vector does not
+     * explain, grouped with the same consistency, size and spread rules on the accumulated field.
+     */
+    static Labels slowMovers(int[] cur, int[] prev, int w, int h, MotionEstimator.Result me, GlobalMotion.Model cam,
+                             float[][] r, float[][] acc, SegConfig c) {
+        SegConfig exact = new SegConfig(c.minTextureVar(), c.maxMatchMad(), c.candMinVar(), c.camSlackMad(),
+                c.camSlackRel(), 0, c.resPx(), c.consPx(), c.consMinMag(), c.consAngleDeg(), c.minRegionBlocks(),
+                c.minRegionFrac(), c.maxSpreadPx(), c.dilate(), c.parallaxDeg(), c.parallaxMinCam(), c.accDecay(), c.accPx());
+        boolean[] e = eligible(cur, w, h, me, c);
+        boolean[] x = cameraExplains(cur, prev, w, h, me, cam, exact);
+        int cols = me.field().cols();
+        int rows = me.field().rows();
+        boolean[] cand = new boolean[e.length];
+        double r2 = c.resPx() * c.resPx();
+        double a2 = c.accPx() * c.accPx();
+        for (int i = 0; i < cand.length; i++) {
+            double rm = (double) r[0][i] * r[0][i] + (double) r[1][i] * r[1][i];
+            double am = (double) acc[0][i] * acc[0][i] + (double) acc[1][i] * acc[1][i];
+            cand[i] = e[i] && (SLOW_SKIP_CAMERA_TEST || !x[i]) && rm <= r2 && am > a2;
+        }
+        byte[] id = new byte[cand.length];
+        int minSize = Math.max(c.minRegionBlocks(), (int) Math.ceil(c.minRegionFrac() * cand.length));
+        grow(cand, acc[0], acc[1], cols, rows, c, minSize, id);
+        return new Labels(cols, rows, id);
+    }
+
+    static boolean SLOW_SKIP_CAMERA_TEST = Boolean.getBoolean("w3.skipcam");
+
+    /** Main-pass labels win; slow-mover regions fill only background blocks, with ids from 128 up. */
+    static Labels union(Labels main, Labels slow) {
+        byte[] out = main.id().clone();
+        for (int i = 0; i < out.length; i++) {
+            if (out[i] == 0 && slow.id()[i] != 0) {
+                out[i] = (byte) Math.min(255, 127 + (slow.id()[i] & 0xFF));
+            }
+        }
+        return new Labels(main.cols(), main.rows(), out);
+    }
